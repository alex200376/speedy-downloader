{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeedDownloader",
  "version": "1.0.2",
  "identifier": "com.speedy.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpeedDownloader 极速下载器",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47812 http://localhost:47812 ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A modern multi-threaded download manager",
    "longDescription": "SpeedDownloader is a modern download manager with multi-segment downloads, resume support and a Chrome extension.",
    "copyright": "Copyright (c) 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}